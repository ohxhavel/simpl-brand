{
  "$description": "Simpl Gateway brand tokens, v1.0 (adopted 8 Sep 2026). Source of truth for §09 of the brand guide. app/tokens.css and lib/brand.ts are generated from this file by `pnpm tokens` — edit hex values here only.",
  "palette": {
    "$type": "color",
    "$description": "Named primitives. Every hex in the system lives here exactly once; semantic tokens alias these.",
    "green": { "$value": "#1D3A34", "$description": "Deep green" },
    "terracotta": { "$value": "#C96F4A", "$description": "Terracotta" },
    "bone": { "$value": "#F6F3EE", "$description": "Bone" },
    "sage": { "$value": "#8D9B96", "$description": "Sage" },
    "ink": { "$value": "#12241F", "$description": "Ink" },
    "body": { "$value": "#2C322F", "$description": "Body text" },
    "slate": { "$value": "#5A6560", "$description": "Secondary" },
    "stone": { "$value": "#EEEBE3", "$description": "Surface" },
    "canvas": { "$value": "#DCD7CE", "$description": "Canvas" },
    "terracotta-deep": { "$value": "#A8532F", "$description": "Terracotta deep" },
    "rule": { "$value": "#DFDAD0", "$description": "Rule" },
    "rule-strong": { "$value": "#C9C3B8", "$description": "Rule strong — control outlines, chart baselines, lockup dividers" },
    "healthy": { "$value": "#3F6F5C", "$description": "Healthy" },
    "degraded": { "$value": "#B0863A", "$description": "Degraded" },
    "failed": { "$value": "#9E3B30", "$description": "Failed" },
    "unbuilt": { "$value": "#7C8B95", "$description": "Not built" },
    "ink-deep": { "$value": "#0B1512", "$description": "Ink deep — inverted surface in dark mode" },
    "ink-page": { "$value": "#17302A", "$description": "Dark page" },
    "ink-rule": { "$value": "#2A473F", "$description": "Dark border" },
    "mist": { "$value": "#DFE5E1", "$description": "Dark text" },
    "mist-muted": { "$value": "#A9B6B1", "$description": "Dark secondary text" },
    "terracotta-light": { "$value": "#E08A62", "$description": "Dark accent" },
    "terracotta-lighter": { "$value": "#E8A183", "$description": "Dark accent text" },
    "healthy-light": { "$value": "#6FA98F", "$description": "Healthy, dark mode text" },
    "degraded-light": { "$value": "#D4A857", "$description": "Degraded, dark mode text" },
    "failed-light": { "$value": "#D97A6C", "$description": "Failed, dark mode text" },
    "unbuilt-light": { "$value": "#9AA9B2", "$description": "Not built, dark mode text" },
    "comment": { "$value": "#5F7A72", "$description": "Code comments and running heads on ink" }
  },
  "colour": {
    "$type": "color",
    "$description": "Semantic tokens. `$value` is light mode, `$extensions.dark` is dark mode. Emitted as --sg-* custom properties.",
    "canvas": { "$value": "{palette.canvas}", "$extensions": { "dark": "{palette.ink}" } },
    "surface": {
      "default": { "$value": "{palette.bone}", "$extensions": { "dark": "{palette.ink-page}" } },
      "raised": { "$value": "{palette.stone}", "$extensions": { "dark": "{palette.green}" } },
      "inverted": { "$value": "{palette.ink}", "$extensions": { "dark": "{palette.ink-deep}" } }
    },
    "border": {
      "default": { "$value": "{palette.rule}", "$extensions": { "dark": "{palette.ink-rule}" } },
      "strong": { "$value": "{palette.rule-strong}", "$extensions": { "dark": "{palette.ink-rule}" } }
    },
    "text": {
      "default": { "$value": "{palette.body}", "$extensions": { "dark": "{palette.mist}" } },
      "strong": { "$value": "{palette.green}", "$extensions": { "dark": "{palette.bone}" } },
      "muted": { "$value": "{palette.slate}", "$extensions": { "dark": "{palette.mist-muted}" } },
      "label": { "$value": "{palette.sage}", "$extensions": { "dark": "{palette.sage}" } }
    },
    "accent": {
      "default": { "$value": "{palette.terracotta}", "$extensions": { "dark": "{palette.terracotta-light}" } },
      "text": { "$value": "{palette.terracotta-deep}", "$extensions": { "dark": "{palette.terracotta-lighter}" } }
    },
    "status": {
      "healthy": { "$value": "{palette.healthy}", "$extensions": { "dark": "{palette.healthy-light}" } },
      "degraded": { "$value": "{palette.degraded}", "$extensions": { "dark": "{palette.degraded-light}" } },
      "failed": { "$value": "{palette.failed}", "$extensions": { "dark": "{palette.failed-light}" } },
      "unbuilt": { "$value": "{palette.unbuilt}", "$extensions": { "dark": "{palette.unbuilt-light}" } }
    },
    "code": {
      "comment": { "$value": "{palette.comment}", "$extensions": { "dark": "{palette.comment}" } }
    },
    "inverted": {
      "$description": "Text on the inverted (ink) surface — code blocks, CTA bands, the console sidebar. Same in both modes.",
      "text": { "$value": "{palette.mist}", "$extensions": { "dark": "{palette.mist}" } },
      "strong": { "$value": "{palette.bone}", "$extensions": { "dark": "{palette.bone}" } },
      "muted": { "$value": "{palette.mist-muted}", "$extensions": { "dark": "{palette.mist-muted}" } },
      "accent": { "$value": "{palette.terracotta-light}", "$extensions": { "dark": "{palette.terracotta-light}" } }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Newsreader", "Georgia", "serif"], "$description": "Headlines only. 300/400, never below 17px, never bold, never uppercase." },
    "sans": { "$value": ["Geist", "system-ui", "sans-serif"], "$description": "UI and prose. 300/400/500; 600 reserved for the console." },
    "mono": { "$value": ["Geist Mono", "ui-monospace", "monospace"], "$description": "Labels, code, numbers, identifiers." }
  },
  "space": {
    "$type": "dimension",
    "$description": "56 is the page gutter everywhere. 26 separates related blocks, 44 separates arguments.",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "18px" },
    "5": { "$value": "26px" },
    "6": { "$value": "34px" },
    "7": { "$value": "44px" },
    "8": { "$value": "56px" },
    "9": { "$value": "76px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Radius grows with the element. Pills are for status only, never for buttons.",
    "ctl": { "$value": "8px" },
    "card": { "$value": "12px" },
    "panel": { "$value": "14px" },
    "page": { "$value": "20px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms", "$description": "Hover, focus" },
      "enter": { "$value": "180ms", "$description": "Enter, expand" },
      "panel": { "$value": "240ms", "$description": "Panel, drawer" }
    },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$description": "One curve for everything. No spring, no bounce." }
  },
  "shadow": {
    "menu": {
      "$type": "shadow",
      "$description": "The only shadow in the system: open menus and dialogs, light mode only.",
      "$value": { "color": "#12241F1F", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" },
      "$extensions": { "dark": "none" }
    }
  }
}
